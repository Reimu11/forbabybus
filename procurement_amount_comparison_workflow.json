          "data": {
            "type": "code",
            "title": "按类别汇总并比较总价",
            "desc": "以数值汇总明细金额，逐类别比较并输出 JSON。",
            "selected": false,
            "code_language": "python3",
            "code": "def main(summary_text: str, detail_text: str) -> dict:\n    import json\n    import re\n    from decimal import Decimal\n\n    def parse_json(text):\n        content = text.strip()\n        try:\n            return json.loads(content)\n        except json.JSONDecodeError:\n            fenced = re.search(r\"```(?:json)?\\s*([\\s\\S]*?)\\s*```\", content)\n            if fenced:\n                return json.loads(fenced.group(1))\n            start = content.find(\"{\")\n            end = content.rfind(\"}\")\n            if start >= 0 and end > start:\n                return json.loads(content[start:end + 1])\n            raise ValueError(\"模型输出不是有效的 JSON\")\n\n    def to_amount(value):\n        if value is None or isinstance(value, bool):\n            raise ValueError(\"金额必须是数值\")\n        cleaned = str(value).replace(\",\", \"\").replace(\"¥\", \"\").replace(\"￥\", \"\").replace(\"元\", \"\").strip()\n        return Decimal(cleaned)\n\n    def get_items(document, name):\n        if not isinstance(document, dict) or not isinstance(document.get(\"items\"), list):\n            raise ValueError(name + \"解析结果必须包含 items 数组\")\n        return document[\"items\"]\n\n    summary = parse_json(summary_text)\n    detail = parse_json(detail_text)\n    summary_totals = {}\n    detail_totals = {}\n\n    for item in get_items(summary, \"汇总表\"):\n        category = str(item.get(\"category\", \"\")).strip()\n        if not category:\n            raise ValueError(\"汇总表存在空货品类别\")\n        if category in summary_totals:\n            raise ValueError(\"汇总表存在重复类别：\" + category)\n        summary_totals[category] = to_amount(item.get(\"total_amount\"))\n\n    for item in get_items(detail, \"明细表\"):\n        category = str(item.get(\"category\", \"\")).strip()\n        if not category:\n            raise ValueError(\"明细表存在空货品类别\")\n        detail_totals[category] = detail_totals.get(category, Decimal(\"0\")) + to_amount(item.get(\"total_amount\"))\n\n    rows = []\n    for category in sorted(set(summary_totals) | set(detail_totals)):\n        summary_amount = summary_totals.get(category)\n        detail_amount = detail_totals.get(category)\n        if summary_amount is None:\n            matched = False\n            status = \"missing_in_summary\"\n            difference = None\n        elif detail_amount is None:\n            matched = False\n            status = \"missing_in_detail\"\n            difference = None\n        else:\n            difference_value = detail_amount - summary_amount\n            matched = difference_value == 0\n            status = \"match\" if matched else \"mismatch\"\n            difference = float(difference_value)\n        rows.append({\n            \"category\": category,\n            \"summary_total\": float(summary_amount) if summary_amount is not None else None,\n            \"detail_total\": float(detail_amount) if detail_amount is not None else None,\n            \"difference\": difference,\n            \"match\": matched,\n            \"status\": status\n        })\n\n    all_match = bool(rows) and all(row[\"match\"] for row in rows)\n    matched_count = sum(1 for row in rows if row[\"match\"])\n    comparison = {\n        \"all_match\": all_match,\n        \"status\": \"all_match\" if all_match else \"mismatch\",\n        \"category_count\": len(rows),\n        \"matched_count\": matched_count,\n        \"mismatched_count\": len(rows) - matched_count,\n        \"categories\": rows\n    }\n    return {\n        \"summary_data\": summary,\n        \"detail_data\": detail,\n        \"comparison_result\": comparison,\n        \"all_match\": all_match\n    }\n",
            "variables": [
